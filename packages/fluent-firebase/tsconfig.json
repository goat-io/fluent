{
  "extends": "@goatlab/tsconfig/tsconfig.json",
  "include": ["src"],
  "exclude": ["**/*.spec.ts", "**/*.test.ts", "src/test/**"],
  "compilerOptions": {
    "declaration": true,
    "outDir": "./dist",
    "baseUrl": "./src",
    "strictNullChecks": true,
    "skipLibCheck": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true
  }
}
