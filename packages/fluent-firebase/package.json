{
  "name": "@goatlab/fluent-firebase",
  "version": "0.8.3",
  "description": "Readable query Interface & API generator for TS and Node",
  "dependencies": {
    "@goatlab/fluent": "workspace:*",
    "@goatlab/js-utils": "workspace:*",
    "@google-cloud/firestore": "^6.0.0",
    "firebase-admin": "^11.0.1"
  },
  "devDependencies": {
    "@goatlab/tsconfig": "workspace:*",
    "@types/node": "^17.0.23",
    "dotenv-cli": "^5.1.0",
    "eslint": "^8.5.0",
    "prettier": "^2.6.1",
    "pretty-quick": "^3.1.3",
    "rimraf": "^3.0.2",
    "testcontainers": "^10.11.0",
    "ts-node": "catalog:",
    "turbo": "^1.1.10",
    "typeorm": "^0.3.17",
    "typescript": "^5.0.0",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "prestart": "rimraf dist",
    "predev": "rimraf dist",
    "test": "vitest run",
    "dev": "tsc --watch",
    "lint": "echo 'skip'",
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.js\"",
    "update:packages": "npm-check-updates -u && yarn",
    "serve": "tsc -w",
    "build": "tsc --skipLibCheck --noEmit false"
  },
  "homepage": "https://docs.goatlab.io",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "typescript",
    "TS"
  ],
  "author": "ignacio.cabrera@goatlab.io",
  "license": "MIT",
  "engines": {
    "node": ">=14.16.0"
  }
}
