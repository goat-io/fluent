{
  "license": "MIT",
  "main": "./dist/index.js",
  "version": "0.1.9",
  "name": "@goatlab/node-xlsx",
  "description": "Efficiently work with xlsx files streams in Node.js",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "format": "biome format --write .",
    "lint": "biome check --write .",
    "prebuild": "rimraf dist",
    "predev": "rimraf dist",
    "prestart": "rimraf dist",
    "serve": "tsc -w",
    "test": "vitest run",
    "update:packages": "npm-check-updates -u && yarn"
  },
  "dependencies": {
    "@goatlab/js-utils": "workspace:*",
    "@goatlab/node-utils": "workspace:*",
    "xlstream": "^2.5.5"
  },
  "types": "./dist/index.d.ts",
  "author": "ignacio.cabrera@goatlab.io",
  "devDependencies": {
    "@biomejs/biome": "^2.1.3",
    "@goatlab/biome": "workspace:*",
    "@goatlab/tsconfig": "workspace:*",
    "@types/node": "^18.15.9",
    "dotenv-cli": "^7.1.0",
    "pretty-quick": "^3.1.3",
    "ts-node": "catalog:",
    "turbo": "^1.1.10",
    "typescript": "^5.0.2",
    "vitest": "^3.2.4"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://docs.goatlab.io",
  "keywords": [
    "typescript",
    "TS"
  ]
}
