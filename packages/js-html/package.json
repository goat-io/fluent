{
  "name": "@goatlab/js-html",
  "version": "0.1.0",
  "description": "Parses html to make it app/react native friendly",
  "homepage": "https://docs.goatlab.io",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "ignacio.cabrera@goatlab.io",
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "./dist/**/*"
  ],
  "scripts": {
    "prebuild": "rimraf dist",
    "prestart": "rimraf dist",
    "predev": "rimraf dist",
    "test": "vitest run",
    "dev": "tsc --watch",
    "lint": "biome check --write .",
    "format": "biome format --write .",
    "update:packages": "npm-check-updates -u && yarn",
    "serve": "tsc -w",
    "build": "tsc",
    "pack": "npm-pack-zip",
    "release": "release-it patch --no-npm.publish --ci",
    "release:patch": "release-it patch --no-npm.publish --ci",
    "release:minor": "release-it minor --no-npm.publish --ci",
    "release:major": "release-it major --no-npm.publish --ci ",
    "rc": "release-it --no-npm.publish --ci --preRelease=rc",
    "rc:patch": "release-it patch --no-npm.publish --ci --preRelease=rc",
    "rc:minor": "release-it minor --no-npm.publish --ci --preRelease=rc",
    "rc:major": "release-it major --no-npm.publish --ci --preRelease=rc",
    "changelog": "auto-changelog --template changelog-template.hbs -p -u --commit-limit false",
    "changelog-debug": "auto-changelog --template changelog-template.hbs -p --template json --output changelog-data.json"
  },
  "keywords": [
    "typescript",
    "TS"
  ],
  "dependencies": {
    "html-truncate": "^1.2.2",
    "htmlparser2": "^10.0.0",
    "linkify-html": "^4.3.1",
    "linkify-plugin-hashtag": "^4.3.1",
    "linkify-plugin-keyword": "^4.3.1",
    "linkify-plugin-mention": "^4.3.1",
    "linkify-plugin-ticket": "^4.3.1",
    "linkifyjs": "^4.3.1",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.3",
    "@goatlab/biome": "workspace:*",
    "@goatlab/tsconfig": "workspace:*",
    "@testcontainers/redis": "^11.0.3",
    "@types/jest": "^27.4.1",
    "@types/node": "^17.0.23",
    "@types/sanitize-html": "2.16.0",
    "dotenv-cli": "^5.1.0",
    "jest": "catalog:",
    "jest-environment-node": "^27.5.1",
    "pretty-quick": "^3.1.3",
    "ts-jest": "catalog:",
    "ts-node": "catalog:",
    "turbo": "^1.1.10",
    "typescript": "^4.6.3",
    "vitest": "^3.1.1"
  },
  "engines": {
    "node": ">=14.16.0"
  }
}
