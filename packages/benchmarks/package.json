{
  "name": "@goatlab/benchmarks",
  "version": "0.2.0",
  "private": true,
  "description": "Performance benchmarking suite for database tools and approaches",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "echo 'skipping build step for benchmarks'",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:container": "vitest run --config vitest.container.config.ts",
    "benchmark": "THINK_TIME=false tsx src/benchmarks/enhanced-all-drivers.ts",
    "benchmark:think": "THINK_TIME=true tsx src/benchmarks/enhanced-all-drivers.ts",
    "benchmark:demo": "THINK_TIME=false tsx src/benchmarks/enhanced-demo.ts",
    "benchmark:demo:think": "THINK_TIME=true tsx src/benchmarks/enhanced-demo.ts",
    "benchmark:basic": "tsx src/benchmarks/containerized-benchmark.ts",
    "benchmark:basic:quick": "BENCHMARK_DURATION=2 tsx src/benchmarks/containerized-benchmark.ts",
    "clean": "rimraf dist",
    "setup:db": "tsx src/setup/database.ts",
    "format": "biome format --write .",
    "lint": "biome check --write ."
  },
  "keywords": [
    "benchmark",
    "performance",
    "database",
    "mysql",
    "prisma",
    "typescript"
  ],
  "author": "ignacio.cabrera@goatlab.io",
  "license": "MIT",
  "dependencies": {
    "@mikro-orm/core": "^6.4.16",
    "@mikro-orm/mysql": "^6.4.16",
    "@prisma/client": "^5.22.0",
    "benchmark": "^2.1.4",
    "boxen": "^5.1.2",
    "chalk": "^4.1.2",
    "cli-progress": "^3.12.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.0.0",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.44.3",
    "knex": "^3.1.0",
    "kysely": "^0.28.3",
    "mysql2": "^3.11.3",
    "prisma-extension-kysely": "^3.0.0",
    "reflect-metadata": "^0.1.13",
    "sequelize": "^6.37.7",
    "typeorm": "^0.3.26"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.3",
    "@goatlab/biome": "workspace:*",
    "@testcontainers/mysql": "^11.0.3",
    "@testcontainers/redis": "^11.0.3",
    "@types/benchmark": "^2.1.5",
    "@types/cli-progress": "^3.11.5",
    "@types/node": "^17.0.23",
    "prisma": "^5.22.0",
    "rimraf": "^5.0.5",
    "tsx": "^4.7.1",
    "typescript": "^5.6.3",
    "vitest": "^3.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
