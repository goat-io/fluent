# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=benchmark_db

# Prisma Database URL
DATABASE_URL="mysql://root:your_password@localhost:3306/benchmark_db"

# Benchmark Settings
BENCHMARK_ITERATIONS=1000
BENCHMARK_WARMUP_RUNS=100
BENCHMARK_CONCURRENCY=1

# Test Data Settings
SEED_USER_COUNT=10000
SEED_PRODUCT_COUNT=10000
SEED_ORDER_COUNT=5000
SEED_REVIEW_COUNT=3000