{
  "name": "@sodium/delphi",
  "version": "0.1.4",
  "private": true,
  "description": "Automated self-correcting dev pipeline with AutoGen agents and LangGraph orchestration",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/graph.ts",
    "start": "tsx src/graph.ts",
    "autogen": "cd python && source venv/bin/activate && python autogen_service.py",
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "lint": "biome check --write .",
    "test": "vitest run tests/",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run tests/graph.integration.spec.ts",
    "test:security": "vitest run tests/security.spec.ts",
    "test:python": "cd python && python -m pytest tests/ -v",
    "test:e2e": "./tests/e2e/smoke.sh",
    "test:all": "npm run test && npm run test:python"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^0.0.39",
    "@ai-sdk/google": "^0.0.35",
    "@ai-sdk/openai": "^0.0.44",
    "@goatlab/js-utils": "workspace:*",
    "@langchain/core": "^0.3.66",
    "@langchain/langgraph": "^0.3.11",
    "@modelcontextprotocol/sdk": "^0.5.0",
    "@opentelemetry/auto-instrumentations-node": "^0.50.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.52.0",
    "@opentelemetry/sdk-metrics": "^1.25.0",
    "@opentelemetry/sdk-node": "^0.52.0",
    "ai": "^3.4.7",
    "dotenv": "^16.4.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ai-sdk/provider-utils": "^3.0.1",
    "@biomejs/biome": "^2.1.3",
    "@goatlab/biome": "workspace:*",
    "@langchain/langgraph-checkpoint-sqlite": "^0.1.5",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-trace-base": "^1.30.1",
    "@opentelemetry/semantic-conventions": "^1.36.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.7",
    "@types/pino": "^7.0.5",
    "@vitest/coverage-v8": "^2.0.0",
    "better-sqlite3": "^12.2.0",
    "c8": "^10.1.2",
    "commander": "^12.0.0",
    "langsmith": "^0.3.53",
    "nock": "^13.5.0",
    "ollama-ai-provider": "^1.2.0",
    "pino": "^9.7.0",
    "pino-pretty": "^13.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "uuid": "^11.1.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
