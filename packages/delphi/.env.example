# OpenAI API Key for AutoGen agents
OPENAI_API_KEY=sk-...

# Anthropic API Key for Claude agents
ANTHROPIC_API_KEY=sk-ant-...

# Redis connection URL (non-standard port to avoid conflicts)
REDIS_URL=redis://localhost:7379

# AutoGen service URL (non-standard port to avoid conflicts)
AUTOGEN_SERVICE_URL=http://localhost:8100

# Optional: Test command
TEST_COMMAND=npm test

# Optional: Enable/disable test execution
ENABLE_TESTS=true

# Optional: Max iterations for refinement loop
MAX_ITERATIONS=5