{
  "name": "@goatlab/node-metascraper",
  "version": "0.1.7",
  "description": "Wrapper around metascrapper to ease the process of getting metadata from a url",
  "homepage": "https://docs.goatlab.io",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "ignacio.cabrera@goatlab.io",
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "./dist/**/*"
  ],
  "scripts": {
    "prebuild": "rimraf dist",
    "prestart": "rimraf dist",
    "predev": "rimraf dist",
    "test": "vitest run",
    "dev": "tsc --watch",
    "lint": "biome check --write .",
    "format": "biome format --write .",
    "update:packages": "npm-check-updates -u && yarn",
    "serve": "tsc -w",
    "build": "tsc",
    "pack": "npm-pack-zip",
    "release": "release-it patch --no-npm.publish --ci",
    "release:patch": "release-it patch --no-npm.publish --ci",
    "release:minor": "release-it minor --no-npm.publish --ci",
    "release:major": "release-it major --no-npm.publish --ci ",
    "rc": "release-it --no-npm.publish --ci --preRelease=rc",
    "rc:patch": "release-it patch --no-npm.publish --ci --preRelease=rc",
    "rc:minor": "release-it minor --no-npm.publish --ci --preRelease=rc",
    "rc:major": "release-it major --no-npm.publish --ci --preRelease=rc",
    "changelog": "auto-changelog --template changelog-template.hbs -p -u --commit-limit false",
    "changelog-debug": "auto-changelog --template changelog-template.hbs -p --template json --output changelog-data.json"
  },
  "keywords": [
    "typescript",
    "TS"
  ],
  "dependencies": {
    "@goatlab/js-utils": "workspace:*",
    "cheerio": "^1.1.0",
    "jimp": "^1.6.0",
    "magic-bytes.js": "^1.12.1",
    "metascraper": "^5.47.1",
    "metascraper-author": "^5.47.1",
    "metascraper-clearbit": "^5.47.1",
    "metascraper-date": "^5.47.1",
    "metascraper-description": "^5.47.1",
    "metascraper-feed": "^5.47.1",
    "metascraper-image": "^5.47.1",
    "metascraper-lang": "^5.47.1",
    "metascraper-logo": "^5.47.1",
    "metascraper-publisher": "^5.47.1",
    "metascraper-title": "^5.47.1",
    "metascraper-url": "^5.47.1",
    "puppeteer": "^24.10.2",
    "puppeteer-core": "^24.10.2",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-adblocker": "^2.13.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.3",
    "@goatlab/biome": "workspace:*",
    "@goatlab/tsconfig": "workspace:*",
    "@testcontainers/redis": "^11.0.3",
    "@types/node": "^18.15.9",
    "dotenv-cli": "^5.1.0",
    "pretty-quick": "^3.1.3",
    "ts-node": "catalog:",
    "turbo": "^1.1.10",
    "typescript": "^4.6.3",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=14.16.0"
  }
}
