{
  "name": "@goatlab/node-backend",
  "version": "0.2.5",
  "description": "Common tools to work with Node.js backend applications.",
  "homepage": "https://docs.goatlab.io",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "ignacio.cabrera@goatlab.io",
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "./dist/**/*"
  ],
  "scripts": {
    "prebuild": "rimraf dist",
    "prestart": "rimraf dist",
    "predev": "rimraf dist",
    "test": "vitest run",
    "dev": "tsc --watch",
    "lint": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.js\"",
    "update:packages": "npm-check-updates -u && yarn",
    "serve": "tsc -w",
    "build": "tsc",
    "pack": "npm-pack-zip",
    "release": "release-it patch --no-npm.publish --ci",
    "release:patch": "release-it patch --no-npm.publish --ci",
    "release:minor": "release-it minor --no-npm.publish --ci",
    "release:major": "release-it major --no-npm.publish --ci ",
    "rc": "release-it --no-npm.publish --ci --preRelease=rc",
    "rc:patch": "release-it patch --no-npm.publish --ci --preRelease=rc",
    "rc:minor": "release-it minor --no-npm.publish --ci --preRelease=rc",
    "rc:major": "release-it major --no-npm.publish --ci --preRelease=rc",
    "changelog": "auto-changelog --template changelog-template.hbs -p -u --commit-limit false",
    "changelog-debug": "auto-changelog --template changelog-template.hbs -p --template json --output changelog-data.json"
  },
  "keywords": [
    "typescript",
    "TS"
  ],
  "dependencies": {
    "@goatlab/js-utils": "workspace:*",
    "@goatlab/node-utils": "workspace:*",
    "@google-cloud/logging-winston": "^6.0.1",
    "@keyv/redis": "^3.0.1",
    "@sentry/node": "^9.42.0",
    "@sentry/profiling-node": "^9.42.0",
    "@trpc/server": "^11.4.3",
    "cors": "^2.8.5",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "geoip-lite": "^1.4.10",
    "helmet": "^8.1.0",
    "keyv": "^4.5.4",
    "kleur": "^4.1.5",
    "mjml": "^4.15.3",
    "node-mocks-http": "^1.17.2",
    "passport-jwt": "^4.0.1",
    "public-ip": "^7.0.1",
    "swagger-ui-express": "^5.0.1",
    "tiny-lru": "^11.3.4",
    "trpc-to-openapi": "^2.3.2",
    "ua-parser-js": "^2.0.4",
    "undici": "^7.12.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@goatlab/tsconfig": "workspace:*",
    "@testcontainers/redis": "^11.0.3",
    "@testcontainers/vault": "^11.4.0",
    "@types/cors": "^2.8.17",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.0",
    "@types/geoip-lite": "^1.4.4",
    "@types/jest": "^27.4.1",
    "@types/mjml": "^4.7.4",
    "@types/node": "^17.0.23",
    "@types/passport-jwt": "^4.0.1",
    "@types/swagger-ui-dist": "^3.30.5",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/ua-parser-js": "^0.7.39",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "dotenv-cli": "^5.1.0",
    "eslint": "^8.5.0",
    "jest": "catalog:",
    "jest-environment-node": "^27.5.1",
    "prettier": "^2.6.1",
    "pretty-quick": "^3.1.3",
    "ts-jest": "catalog:",
    "ts-node": "catalog:",
    "turbo": "^1.1.10",
    "typescript": "^5.6.3",
    "vitest": "^3.1.1"
  },
  "engines": {
    "node": ">=14.16.0"
  }
}
