<!-- 
   Parameters: 
    ref: URL to redirect
    text: Text to display in the button 
-->
<mj-button
  background-color="<%= theme.primaryColor %>"
  border-radius="60px 60px 60px 60px"
  font-size="16px"
  font-weight="700"
  color="<%= theme.buttonTextColor %>"
  container-background-color="#ffffff"
  font-family="Helvetica, sans-serif"
  width="95%"
  height="55px"
  href="<%= ref %>"
>
  <%= text %>
</mj-button>
