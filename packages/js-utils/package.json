{
  "author": "ignacio.cabrera@goatlab.io",
  "name": "@goatlab/js-utils",
  "version": "0.9.0",
  "license": "MIT",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && cp -R ./src/Got/ky ./dist/Got/ky",
    "dev": "tsc --watch",
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.js\"",
    "lint": "eslint src --fix",
    "prebuild": "rimraf dist",
    "predev": "rimraf dist",
    "prestart": "rimraf dist",
    "serve": "tsc -w",
    "test": "vitest run",
    "update:packages": "npm-check-updates -u && yarn",
    "build:ky": "tsup --config tsup.config.ts && ts-node ./postBuildKy.ts"
  },
  "dependencies": {
    "@lukeed/uuid": "^2.0.1",
    "nanoid": "^3.3.11",
    "typed-path": "^2.2.3"
  },
  "description": "Readable query Interface & API generator for TS and Node",
  "devDependencies": {
    "@goatlab/tsconfig": "workspace:*",
    "vitest": "^3.2.4",
    "@types/node": "^17.0.23",
    "@yarnpkg/esbuild-plugin-pnp": "3.0.0-rc.15",
    "abort-controller": "^3.0.0",
    "dotenv-cli": "^5.1.0",
    "esbuild": "^0.25.5",
    "eslint": "^8.5.0",
    "ky": "^1.8.1",
    "prettier": "^2.6.1",
    "pretty-quick": "^3.1.3",
    "ts-node": "catalog:",
    "tsup": "^8.5.0",
    "turbo": "^1.1.10",
    "typescript": "^4.6.3",
    "web-streams-polyfill": "^4.1.0"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://docs.goatlab.io",
  "keywords": [
    "typescript",
    "TS"
  ],
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "types": "dist/index.d.ts"
}
