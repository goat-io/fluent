  "name": "@goatlab/node-utils",
  "version": "0.10.4",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "format": "biome format --write .",
    "lint": "biome check --write .",
    "prebuild": "rimraf dist",
    "predev": "rimraf dist",
    "prestart": "rimraf dist",
    "serve": "tsc -w",
    "test": "vitest run --reporter=verbose",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "update:packages": "npm-check-updates -u && yarn"
  },
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@goatlab/js-utils": "workspace:*",
    "@goatlab/tsconfig": "workspace:*",
    "bcrypt": "^6.0.0",
    "bson": "^6.10.4",
    "jsonwebtoken": "^9.0.2",
    "kleur": "^4.1.5",
    "net": "^1.0.2",
    "path": "^0.12.7",
    "portfinder": "^1.0.37",
    "through2-concurrent": "^2.0.0",
    "winston": "^3.17.0"
  },
  "description": "Readable query Interface & API generator for TS and Node",
  "devDependencies": {
    "@biomejs/biome": "^2.1.3",
    "@goatlab/biome": "workspace:*",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^18.15.9",
    "@types/through2-concurrent": "^2.0.1",
    "@vitest/ui": "^3.2.4",
    "dotenv-cli": "^7.1.0",
    "happy-dom": "^18.0.1",
    "pretty-quick": "^3.1.3",
    "ts-node": "^10.9.1",
    "turbo": "^1.1.10",
    "typescript": "^5.0.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=14.16.0"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://docs.goatlab.io",
  "keywords": [
    "typescript",
    "TS"
  ]
}
