{
  "extends": "@goatlab/tsconfig/tsconfig.json",
  "include": ["src"],
  "exclude": ["dist"],
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": "./src",
    "strictNullChecks": false,
    "types": ["node"],
    "skipLibCheck": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true
  }
}
