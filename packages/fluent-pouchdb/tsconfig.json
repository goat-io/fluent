{
  "extends": "@goatlab/tsconfig/tsconfig.json",
  "include": ["src/**/*"],
  "exclude": [
    "src/**/*.spec.*",
    "src/**/*.test.*",
    "src/tests/**",
    "dist",
    "node_modules"
  ],
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": "./src",
    "strictNullChecks": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  }
}
