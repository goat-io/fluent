{
  "license": "MIT",
  "main": "./dist/index.js",
  "name": "@goatlab/typesense",
  "description": "Modern TypeScript wrapper for Typesense search engine API",
  "author": "ignacio.cabrera@goatlab.io",
  "version": "0.1.2",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "format": "biome format --write .",
    "lint": "biome check --write .",
    "prebuild": "rimraf dist",
    "predev": "rimraf dist",
    "prestart": "rimraf dist",
    "serve": "tsc -w",
    "test": "vitest run --reporter=verbose",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "update:packages": "npm-check-updates -u && yarn"
  },
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@goatlab/js-utils": "workspace:*",
    "@goatlab/tsconfig": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.3",
    "@goatlab/biome": "workspace:*",
    "@testcontainers/mysql": "^11.0.3",
    "@types/node": "^18.15.9",
    "@vitest/ui": "^3.2.4",
    "dotenv-cli": "^7.1.0",
    "happy-dom": "^18.0.1",
    "pretty-quick": "^3.1.3",
    "rimraf": "^5.0.1",
    "testcontainers": "^11.3.1",
    "ts-node": "^10.9.1",
    "turbo": "^1.1.10",
    "typescript": "^5.0.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=14.16.0"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://docs.goatlab.io",
  "keywords": [
    "typesense",
    "search",
    "api",
    "wrapper",
    "typescript",
    "search-engine",
    "full-text-search"
  ]
}
