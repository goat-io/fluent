{
  "name": "@goatlab/fluent-formio",
  "version": "0.8.33",
  "description": "Readable query Interface & API generator for TS and Node",
  "homepage": "https://docs.goatlab.io",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "./dist/**/*"
  ],
  "scripts": {
    "prebuild": "rimraf dist",
    "prestart": "rimraf dist",
    "predev": "rimraf dist",
    "test": "vitest run",
    "dev": "tsc --watch",
    "lint": "biome check --write .",
    "format": "biome format --write .",
    "update:packages": "npm-check-updates -u && yarn",
    "serve": "tsc -w",
    "build": "tsc"
  },
  "keywords": [
    "typescript",
    "TS"
  ],
  "author": "ignacio.cabrera@goatlab.io",
  "license": "MIT",
  "dependencies": {
    "@goatlab/fluent": "workspace:*",
    "@goatlab/js-utils": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.3",
    "@goatlab/biome": "workspace:*",
    "@goatlab/tsconfig": "workspace:*",
    "@types/node": "^17.0.23",
    "dotenv-cli": "^5.1.0",
    "pretty-quick": "^3.1.3",
    "ts-node": "catalog:",
    "turbo": "^2.9.14",
    "typescript": "^4.6.3",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=14.16.0"
  }
}
