{
  "name": "@goatlab/fluent",
  "version": "0.5.20",
  "description": "Readable query Interface & API generator for TS and Node",
  "homepage": "https://docs.goatlab.io",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "nohoist": [],
    "catalog": {
      "eslint": "^9.13.0",
      "prettier": "^3.3.3",
      "prisma": "^6.5.0",
      "tailwindcss": "^3.4.14",
      "typescript": "^5.6.3",
      "zod": "^4.0.10",
      "concurrently": "^9.1.2",
      "tsx": "^4.19.2",
      "ts-jest": "^29.2.6",
      "ts-node": "^10.9.2",
      "jest": "^29.7.0",
      "vitest": "^2.1.8",
      "unplugin-swc": "^1.5.5"
    }
  },
  "scripts": {
    "build": "pnpm lint && turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test --filter=!@goatlab/benchmarks --filter=!@goatlab/fluent --filter=!@goatlab/fluent-firebase --filter=!@goatlab/tasks-adapter-gcp",
    "test-ci": "turbo run test --filter=!@goatlab/benchmarks --filter=!@goatlab/fluent --filter=!@goatlab/fluent-firebase --filter=!@goatlab/tasks-adapter-gcp",
    "lint": "turbo run lint",
    "cs": "changeset",
    "cs:version": "changeset version",
    "cs:publish": "pnpm build && changeset publish",
    "clean": "rimraf node_modules && pnpm clean:modules",
    "clean:modules": "find . -name 'node_modules' -type d -prune -print | xargs -I {} rm -rf \"{}\"",
    "clean:turbo": "pnpm turbo run clean && rm -rf node_modules",
    "act": "act --container-architecture linux/amd64 -W '.github/workflows/test.yml'",
    "push": "git push origin master && git push --follow-tags"
  },
  "author": "ignacio.cabrera@goatlab.io",
  "license": "MIT",
  "dependencies": {
    "@changesets/cli": "^2.29.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.3",
    "@elysiajs/trpc": "^1.1.0",
    "elysia": "^1.4.16",
    "turbo": "^2.5.5",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=14.16.0"
  },
  "packageManager": "pnpm@9.15.2",
  "pnpm": {
    "overrides": {
      "@sinclair/typebox": "^0.34.0"
    }
  }
}
